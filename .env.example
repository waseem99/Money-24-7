LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_CONTEXT_ID=
STUDIO_ACCESS_TOKEN=
LIVEAVATAR_SANDBOX=true
# Optional shared HLS program feed. Keep this URL public and credential-free.
VITE_CHANNEL_HLS_URL=
# Stock market feed: requires appropriate display/redistribution rights.
FINNHUB_API_KEY=

# Prepared pilot worker only. Real values belong in .env.local, never VITE_*.
# Dummy values are rejected before any provider call.
AI_GATEWAY_API_KEY=DUMMY_NOT_CONFIGURED
AI_GATEWAY_MODEL=DUMMY_SELECT_FROM_GATEWAY_CATALOG
ELEVENLABS_API_KEY=DUMMY_NOT_CONFIGURED
ELEVENLABS_MODEL_ID=DUMMY_SELECT_SUPPORTED_MODEL
ELEVENLABS_ANCHOR_VOICE_ID=DUMMY_AUDITION_FIRST
ELEVENLABS_ANALYST_VOICE_ID=DUMMY_AUDITION_FIRST
HEYGEN_API_KEY=DUMMY_NOT_CONFIGURED
HEYGEN_ANCHOR_AVATAR_ID=DUMMY_AUDITION_FIRST
HEYGEN_ANALYST_AVATAR_ID=DUMMY_AUDITION_FIRST
# Operator estimates, not provider prices or hard billing limits.
PILOT_MAX_ESTIMATED_USD=0
PILOT_SPEECH_ESTIMATE_USD=0
PILOT_AVATAR_ESTIMATE_USD=0
PILOT_DIRECTOR_ESTIMATE_USD=0
# Optional illustration; model must support generateImage.
AI_IMAGE_MODEL=DUMMY_SELECT_SUPPORTED_IMAGE_MODEL
PILOT_IMAGE_ESTIMATE_USD=0
# Absolute durable PRIVATE directory recommended for production worker.
# PILOT_DATA_DIR=/private/signal/pilot-runs
# PILOT_REVIEW_PORT=4310
# PILOT_REVIEW_TOKEN=  # or worker generates a private local token file
