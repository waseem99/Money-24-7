      "playbackSpeed": null
    },
    {
      "id": "rates",
      "kind": "voice",
      "showSceneId": "rates",
      "start": 84.7,
      "duration": 19.7,
      "end": 104.4,
      "source": "r2/rates.mp4",
      "role": "LASSE",
      "sourceDuration": 20.088,
      "words": "Two powerful forces are colliding. Big technology profits look promising. Yet borrowing is costly. In September the Federal Reserve raised its policy range to three and three quarters through four percent. Treasury yields have climbed to multi-decade highs. That's a serious valuation test, even for companies delivering good results.",
      "playbackSpeed": 1.02
    },
    {
      "id": "transition_rates",
      "kind": "graphics",
      "showSceneId": "rates",
      "start": 104.4,
      "duration": 3,
